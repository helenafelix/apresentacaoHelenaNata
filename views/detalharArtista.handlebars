<div class="section-heading">
  <div>
    <p class="heading">PERFIL</p>
    <h1 class="title">{{artista.nome}}</h1>
  </div>
  <a class="action-link action-light" href="/artistas">← Voltar</a>
</div>
<div class="columns">
  <div class="column is-one-third">
    <div class="card">
      <div class="card-content">
        <p class="heading">NOME COMPLETO</p>
        <p class="detail-value">{{artista.nome}}</p>
        <hr />
        <p class="heading">ANO DE NASCIMENTO</p>
        <p class="detail-value">{{artista.anoNascimento}}</p>
        <hr />
        <p class="heading">NOME ARTÍSTICO</p>
        <p class="detail-value">{{artista.nomeArtistico}}</p>
      </div>
    </div>
  </div>
  <div class="column">
    <div class="card">
      <header class="card-header">
        <p class="card-header-title">Filmes relacionados</p>
      </header>
      <div class="card-content">
        {{#if artista.filmes }}
        <div class="content">
          <ul>
            {{#each artista.filmes}}
            <li>
              <a href="/filmes/{{this.id}}">{{this.nome}} ({{this.ano}})</a>
            </li>
            {{/each}}
          </ul>
        </div>
        {{else}}
        <div class="notification is-info is-light">
          Nenhum filme relacionado.
        </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>
