<div class="form-card">
  <div class="mb-5">
    <p class="heading">EDIÇÃO</p>
    <h1 class="title">Editar diretor</h1>
  </div>
  <div class="card">
    <div class="card-content">
      <form action="/diretores/{{diretor.id}}?_method=PUT" method="POST">
        <div class="field">
          <label class="label" for="nome">Nome</label>
          <div class="control">
            <input
              class="input"
              id="nome"
              type="text"
              name="nome"
              value="{{diretor.nome}}"
              required
            />
          </div>
        </div>
        <div class="field">
          <label class="label" for="anoNascimento">Ano de nascimento</label>
          <div class="control">
            <input
              class="input"
              id="anoNascimento"
              type="number"
              name="anoNascimento"
              value="{{diretor.anoNascimento}}"
              required
            />
          </div>
        </div>
        <div class="field">
          <label class="label" for="nacionalidade">Nacionalidade</label>
          <div class="control">
            <input
              class="input"
              id="nacionalidade"
              type="text"
              name="nacionalidade"
              value="{{diretor.nacionalidade}}"
              required
            />
          </div>
        </div>
        <div class="field is-grouped mt-5">
          <div class="control">
            <input
              class="action-link action-primary"
              type="submit"
              value="Salvar alterações"
            />
          </div>
          <div class="control">
            <a class="action-link action-light" href="/">Cancelar</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
